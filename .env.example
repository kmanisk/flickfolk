# Flickfolk runtime configuration. Keep actual secrets in the ignored project-root .env.
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# Optional additional browser origin for split client/server development.
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 only behind a trusted single-hop proxy (Render). Keep 0 locally.
TRUST_PROXY=0

# Browser-visible ICE settings, loaded at runtime; no API key is required.
STUN_URLS=stun:stun.l.google.com:19302
# Optional dedicated TURN relay. Comma-separated turn:/turns: URLs.
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=

# Optional server-only GIF search key. Never use a VITE_ variable for this key.
# Confirm GIPHY approval for server proxy/cache use before production.
GIPHY_API_KEY=

# Copy to project-root .env; dev and production npm scripts load it.
# Restart after setting GIPHY_API_KEY. Search stays hidden until its provider check succeeds.
